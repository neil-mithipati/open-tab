{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "prometheus",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000"
  },
  "permissions": {
    "deny": [
      "Bash(git filter-branch *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-irreversible.sh",
            "args": [],
            "statusMessage": "Checking command against denial list"
          }
        ]
      },
      {
        "matcher": "Agent|Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/spend-cap.sh",
            "args": [],
            "statusMessage": "Checking spend cap"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secrets.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/parallel-cap.sh",
            "args": []
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/status-page.sh",
            "args": [],
            "async": true
          }
        ]
      },
      {
        "matcher": "^builder$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "builder"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^builder-deep$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "builder-deep"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^builder-light$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "builder-light"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^publisher$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "publisher"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "reviewer"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^reviewer-light$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "reviewer-light"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "builder-light|builder|builder-deep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-tests.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-trivial.sh",
            "args": []
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^builder$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "builder"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^builder-deep$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "builder-deep"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^builder-light$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "builder-light"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^publisher$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "publisher"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "reviewer"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "^reviewer-light$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [
              "reviewer-light"
            ],
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "args": [],
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/status-page.sh",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/loop-until-done.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
