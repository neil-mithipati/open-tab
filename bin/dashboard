#!/bin/bash
# bin/dashboard — live view of the fleet, for watching a build happen.
#
#   ./bin/dashboard              refresh every 20s
#   ./bin/dashboard 5            refresh every 5s
#
# This is a *local* complement to STATUS.md, not a replacement. STATUS.md is
# debounced to one push per minute and needs a push to a remote before you can
# see it, which is right for "check from your phone later." This is for watching
# a build happen in your terminal, so it re-reads the same local state on every
# tick instead of waiting on a push.
#
# Three states per role, and they come from two different sources deliberately:
#
#   running  — a SubagentStart with no matching SubagentStop for that role, from
#              .claude/state/events.jsonl. This is "an agent is executing right now."
#   blocked  — a ledger task assigned to that tier has state: blocked. This is
#              "work exists for this role but nothing can proceed," which is a
#              property of the ledger, not of any single agent invocation.
#   idle     — neither of the above. Nothing to report; not a fault.
#
# A role can show both running and blocked at once — a builder can be actively
# retrying a task another builder task on the same tier is blocked on. Both lines
# are shown rather than collapsed into one state.

set -u

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
STATE="$ROOT/.claude/state"
EVENTS="$STATE/events.jsonl"
SPEND="$STATE/spend.json"
BUDGET="$ROOT/.claude/budget.json"
LEDGER="$ROOT/ledger"
INTERVAL="${1:-20}"

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

ROLES="orchestrator builder-light builder builder-deep reviewer reviewer-deep publisher"

render() {
  printf '\033[1magent fleet — %s\033[0m\n' "$(date -u +"%Y-%m-%d %H:%M:%S UTC")"
  printf 'refreshing every %ss · ctrl-c to stop\n\n' "$INTERVAL"

  # ---------- per-agent status ----------
  printf '\033[1m%-15s %-9s %-16s %-8s\033[0m\n' "ROLE" "STATUS" "TASK" "LANE"

  # Liveness is computed by the same shared rule the cap enforces —
  # .claude/hooks/liveness.sh. If this dashboard ever disagrees with what
  # dispatch allows, the bug is there, in one place.
  running_json="[]"
  if . "$ROOT/.claude/hooks/liveness.sh" 2>/dev/null; then
    fleet_live_json "$EVENTS"
    running_json="$LIVE_JSON"
  fi

  blocked_tiers=""
  if [ -d "$LEDGER" ]; then
    for f in "$LEDGER"/*.md; do
      [ -e "$f" ] || continue
      st=$(sed -n 's/^state:[[:space:]]*//p' "$f" | head -1)
      tr=$(sed -n 's/^tier:[[:space:]]*//p'  "$f" | head -1)
      [ "$st" = "blocked" ] && [ -n "$tr" ] && blocked_tiers="$blocked_tiers $tr"
    done
  fi

  # Task ids currently in-progress, keyed by tier. Builder rows match exactly
  # via the tier field, which is authoritative. reviewer/reviewer-deep/
  # publisher have no such field — nothing in the ledger records which pipeline
  # stage an in-progress task is at — so those rows fall back to "any
  # in-progress task" as candidates, not a confirmed 1:1 pairing.
  inprog_by_tier=""
  inprog_all=""
  if [ -d "$LEDGER" ]; then
    for f in "$LEDGER"/*.md; do
      [ -e "$f" ] || continue
      st=$(sed -n 's/^state:[[:space:]]*//p' "$f" | head -1)
      [ "$st" = "in-progress" ] || continue
      tid=$(sed -n 's/^id:[[:space:]]*//p'   "$f" | head -1)
      tr=$(sed -n 's/^tier:[[:space:]]*//p'  "$f" | head -1)
      tid="${tid:-$(basename "$f" .md)}"
      inprog_by_tier="$inprog_by_tier|${tr:-?}:$tid"
      inprog_all="$inprog_all${inprog_all:+,}$tid"
    done
  fi

  task_for_role() {
    local role="$1"
    case "$role" in
      builder-light|builder|builder-deep)
        printf '%s' "$inprog_by_tier" | tr '|' '\n' | awk -F: -v t="$role" '$1==t{print $2}' | paste -sd, -
        ;;
      reviewer|reviewer-deep|publisher)
        printf '%s' "$inprog_all"
        ;;
    esac
  }

  for role in $ROLES; do
    lane=$(printf '%s' "$running_json" | jq -r --arg r "$role" '.[] | select(.type==$r) | .lane' 2>/dev/null | head -1)
    count=$(printf '%s' "$running_json" | jq -r --arg r "$role" '.[] | select(.type==$r) | .running' 2>/dev/null | head -1)
    is_running=$(printf '%s' "$running_json" | jq -r --arg r "$role" 'map(select(.type==$r)) | length > 0' 2>/dev/null)
    is_blocked=no
    case " $blocked_tiers " in *" $role "*) is_blocked=yes ;; esac

    task=$(task_for_role "$role")
    [ -z "$task" ] && task="-"
    # Truncate so a long comma list doesn't blow out the row width.
    [ "${#task}" -gt 16 ] && task="${task:0:14}.."

    running_label="running"
    [ -n "$count" ] && [ "$count" -gt 1 ] 2>/dev/null && running_label="running ×$count"

    if [ "$is_running" = "true" ] && [ "$is_blocked" = "yes" ]; then
      printf '\033[32m●\033[0m %-13s \033[32m%-9s\033[0m %-16s %-8s\n' "$role" "$running_label" "$task" "${lane:--}"
      printf '\033[31m●\033[0m %-13s \033[31m\033[1m%-9s\033[0m %-16s %-8s\n' "" "Blocked" "-" "(below)"
    elif [ "$is_running" = "true" ]; then
      printf '\033[32m●\033[0m %-13s \033[32m%-9s\033[0m %-16s %-8s\n' "$role" "$running_label" "$task" "${lane:--}"
    elif [ "$is_blocked" = "yes" ]; then
      printf '\033[31m●\033[0m %-13s \033[31m\033[1m%-9s\033[0m %-16s %-8s\n' "$role" "Blocked" "-" "(below)"
    else
      printf '\033[90m●\033[0m %-13s \033[90m%-9s\033[0m %-16s %-8s\n' "$role" "idle" "-" "-"
    fi
  done

  # ---------- blocked — needs your input ----------
  # The one section rendered in red: each blocked task with its ask
  # (blocked_reason) inline, so what needs the owner is visible without
  # opening the ledger. Same dot format as the agent rows above.
  if [ -d "$LEDGER" ]; then
    b_rows=""
    for f in "$LEDGER"/*.md; do
      [ -e "$f" ] || continue
      st=$(sed -n 's/^state:[[:space:]]*//p' "$f" | head -1)
      [ "$st" = "blocked" ] || continue
      bid=$(sed -n 's/^id:[[:space:]]*//p' "$f" | head -1)
      br=$(yaml_field blocked_reason "$f" 2>/dev/null)
      b_rows="${b_rows}$(printf '\033[31m●\033[0m \033[1m%-13s\033[0m \033[31m%s\033[0m' "${bid:-?}" "${br:-no blocked_reason recorded — check the task file}")
"
    done
    if [ -n "$b_rows" ]; then
      printf '\n\033[31m\033[1m● Blocked — needs your input\033[0m\n'
      printf '%s' "$b_rows"
    fi
  fi

  # ---------- spend ----------
  printf '\n\033[1m%-10s %10s %10s  %s\033[0m\n' "LANE" "SPENT" "CAP" "USED"
  if [ -s "$SPEND" ] && [ -s "$BUDGET" ]; then
    jq -r --slurpfile b "$BUDGET" '
      ($b[0].lanes // {}) as $caps
      | ($b[0].default // 0) as $fallback
      | (.lanes // {}) | to_entries[]
      | . as $e
      | ($caps[$e.key] // $fallback) as $cap
      | (if $cap > 0 then (($e.value / $cap) * 100) else 0 end) as $pct
      | (($pct / 10) | floor | if . > 10 then 10 else . end) as $filled
      | "\(.key)\t\(.value)\t\(.value * 100 | round / 100)\t\($cap)\t\($filled)\t\($pct | floor)"
    ' "$SPEND" 2>/dev/null | while IFS=$'\t' read -r lane raw spent cap filled pct; do
      bar=$(printf '█%.0s' $(seq 1 "$filled") 2>/dev/null)
      bar="$bar$(printf '░%.0s' $(seq 1 $((10 - filled))) 2>/dev/null)"
      color=32; [ "$pct" -ge 80 ] && color=33; [ "$pct" -ge 100 ] && color=31
      printf '%-10s %10s %10s  \033[%sm%s %3s%%\033[0m\n' "$lane" "\$$spent" "\$$cap" "$color" "$bar" "$pct"
    done
  else
    echo "no spend data — is spend-poll.sh running?"
  fi

  # ---------- ledger summary ----------
  if [ -d "$LEDGER" ]; then
    todo=0; prog=0; done=0; blocked=0
    for f in "$LEDGER"/*.md; do
      [ -e "$f" ] || continue
      st=$(sed -n 's/^state:[[:space:]]*//p' "$f" | head -1)
      case "$st" in
        todo) todo=$((todo+1)) ;;
        in-progress) prog=$((prog+1)) ;;
        done) done=$((done+1)) ;;
        blocked) blocked=$((blocked+1)) ;;
      esac
    done
    printf '\n\033[1mtasks\033[0m  todo %s · in-progress %s · done %s · \033[31mblocked %s\033[0m\n' \
      "$todo" "$prog" "$done" "$blocked"

    # Recent ledger updates, one line each, newest first. Detail is a
    # deliberate click away: ./bin/task <id>.
    recent=$(ls -t "$LEDGER"/*.md 2>/dev/null | head -5)
    if [ -n "$recent" ]; then
      printf '\033[1mrecent\033[0m'
      printf '%s\n' "$recent" | while IFS= read -r f; do
        rid=$(sed -n 's/^id:[[:space:]]*//p'    "$f" | head -1)
        rst=$(sed -n 's/^state:[[:space:]]*//p' "$f" | head -1)
        n_open=$(awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; next} n>=2{print}' "$f" \
          | grep -c '^[[:space:]]*- \[ \]' || true)
        extra=""
        [ "$n_open" -gt 0 ] 2>/dev/null && extra=" ($n_open open)"
        case "$rst" in
          blocked) printf ' \033[31m%s %s%s\033[0m ·' "${rid:-?}" "$rst" "$extra" ;;
          *)       printf ' %s %s%s ·' "${rid:-?}" "${rst:-todo}" "$extra" ;;
        esac
      done
      printf '\b \033[90m— ./bin/task <id> to expand\033[0m\n'
    fi
  fi
}

# ---------- loop ----------
# No `watch` on macOS by default, so this is the plain clear-and-redraw pattern.
if [ -t 1 ]; then
  while :; do
    clear
    render
    sleep "$INTERVAL"
  done
else
  render
fi
