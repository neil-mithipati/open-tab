#!/usr/bin/env bash
# bin/finish-worktree — merges a task's branch into main and removes the
# worktree. Must be run from the main checkout, never from inside a worktree.
#
#   ./bin/finish-worktree TB-004
#
# Refuses rather than forcing through anything unsafe: uncommitted changes in
# the worktree, or a merge that doesn't fast-forward or apply clean. On refusal
# the worktree is left exactly as it was — nothing is deleted until the merge
# has actually succeeded.
#
# The one exception is narrow and loud: if every uncommitted change is a revert
# to a revision of that same file already in the branch's history — the mark of
# a read-only reviewer that ran `git checkout <rev> -- <path>` and never put it
# back — the file is restored from HEAD and the merge continues, with the
# pre-repair state saved as a patch. See the triage block below.

set -euo pipefail

ID="${1:-}"
[ -z "$ID" ] && { echo "usage: ./bin/finish-worktree <task-id>" >&2; exit 1; }

case "$ID" in
  *[!A-Za-z0-9_-]*) echo "task id must be alphanumeric, - or _ only: $ID" >&2; exit 1 ;;
esac

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repo" >&2; exit 1; }
cd "$ROOT"

CUR_BRANCH="$(git symbolic-ref --short -q HEAD || true)"
if [ -z "$CUR_BRANCH" ]; then
  echo "HEAD is detached — run this from the trunk checkout, not inside a worktree" >&2
  exit 1
fi
# Refuse to run from inside a task worktree, whatever the trunk happens to be
# named — checked by looking for a task/ branch prefix pattern rather than
# assuming the trunk is literally called "main" or "master".
case "$CUR_BRANCH" in
  task/*) echo "run this from the trunk checkout, not from inside a worktree (currently on: $CUR_BRANCH)" >&2; exit 1 ;;
esac

BRANCH="task/$ID"
WT_DIR="../wt-$ID"

if ! git rev-parse --verify -q "$BRANCH" >/dev/null; then
  echo "no branch $BRANCH — nothing to finish" >&2
  exit 1
fi

# Where the branch diverged from trunk, and which paths the branch's own
# commits touched since then. Used by the triage below (OT-126) to tell a
# genuine revert-to-an-earlier-value apart from a stray `git checkout`: see
# the comment above triage_worktree for why this matters.
BRANCH_POINT="$(git merge-base "$CUR_BRANCH" "$BRANCH" 2>/dev/null || true)"
if [ -n "$BRANCH_POINT" ]; then
  TOUCHED_BY_BRANCH="$(git diff --name-only "$BRANCH_POINT" "$BRANCH" -- 2>/dev/null || true)"
else
  TOUCHED_BY_BRANCH=""
fi

path_touched_by_branch() {
  # No branch point means we cannot tell what the branch touched — bias
  # toward treating the path as branch-touched (i.e. refuse repair on it)
  # rather than guessing it is safe.
  [ -z "$BRANCH_POINT" ] && return 0
  printf '%s\n' "$TOUCHED_BY_BRANCH" | grep -Fxq -- "$1"
}

# --- uncommitted-change triage (OT-122) --------------------------------------
#
# A read-only reviewer left a STAGED revert sitting in a worktree: it ran
# `git checkout <old-rev> -- <path>` to compare before/after while reviewing,
# then never restored the file. The `disallowedTools: Write, Edit` contract on
# reviewer agents is enforced on those two tools only, and git is a perfectly
# capable file editor reachable from Bash.
#
# Of the three options in ledger/OT-122.md this is option 3, detect-and-repair.
# Why not the other two:
#   1. A PreToolUse Bash guard for read-only agents has to be registered in
#      .claude/settings.json, which was under concurrent edit by OT-121; and a
#      string-match guard over arbitrary shell is exactly the kind of thing
#      that starts denying legitimate reviews, which costs more than the bug.
#   2. Handing reviewers a read-only view changes how every reviewer prompt
#      addresses paths — the largest blast radius for the smallest repo.
#   3. This sits on the path that already caught the incident, costs one
#      function, and cannot make a review harder because it does not run
#      during one.
#
# The rule that keeps this from swallowing real work: a dirty path is
# repairable only if ALL of the following hold (OT-126 tightened this after a
# reviewer drove the OT-122 version against fixture repos and found a false
# positive):
#
#   1. The branch's own commits never touched this path. A read-only reviewer
#      running `git checkout <rev> -- <path>` only ever does it on a path it
#      is inspecting, not one this branch's builder actually changed — so if
#      the branch's commits modified the path, a content match to some old
#      revision is far more likely to be a deliberate revert-to-an-earlier-
#      value (ordinary work: think a config flag cycling false -> true ->
#      false) than an accident. Those paths are always genuine now, whatever
#      their content matches.
#   2. For the paths the branch never touched, the working-tree content is
#      byte-identical (content AND mode) to some revision of that path that is
#      an ancestor of the branch's point of divergence from trunk — not merely
#      "reachable from HEAD", which is a much bigger and less meaningful set
#      once the branch's own commits are excluded. Restricting to ancestors of
#      the branch point is what makes rule 1 airtight: a path outside it by
#      definition has no branch commit whose content could produce a
#      coincidental match to old trunk history.
#
# That combination is precisely the `git checkout <rev> -- <path>` signature
# on a path the reviewer was reading, not editing, and it is the only case
# where discarding the change provably loses nothing, because the content is
# still in history and no work of this branch's own is at risk. Anything else
# — an untracked file, a new file, a deletion, a rename, a path the branch
# itself modified, or any content that has never existed before the branch
# started — is genuine unmerged work and still refuses, exactly as before. If
# even one path is genuine, nothing is repaired and the whole thing refuses.
# And the pre-repair state is written out as a patch first, so the repair
# itself is reversible too.
#
# A path that is both staged AND further modified in the working tree (git
# status `MM`) is always treated as genuine, never repaired, even if its
# working-tree content would otherwise match. The patch below is a
# worktree-vs-HEAD diff; it does not capture the index, so repairing an `MM`
# path would silently drop the staged blob with no copy anywhere except
# `git fsck --unreachable`. Refusing is simpler than teaching the patch step
# to also capture `git diff --cached`, and every `MM` path is genuine anyway
# from the same reasoning as rule 1 above, so refusing here costs nothing.

GENUINE=()
REPAIRABLE=()
MATCHES=()

triage_worktree() {
  local entry st p orig rev matched mode_only_rev rev_blob wt_blob

  while IFS= read -r -d '' entry; do
    st="${entry:0:2}"
    p="${entry:3}"

    case "$st" in
      '??')
        GENUINE+=("$p (untracked)")
        continue ;;
      R?|?R|C?|?C)
        # rename/copy emits a second NUL field holding the original path
        IFS= read -r -d '' orig || orig="?"
        GENUINE+=("$p (renamed/copied from $orig, not committed)")
        continue ;;
      A?|?A)
        GENUINE+=("$p (added, not committed)")
        continue ;;
      U?|?U)
        GENUINE+=("$p (unmerged)")
        continue ;;
      *D*)
        GENUINE+=("$p (deleted, not committed)")
        continue ;;
      M?)
        if [ "${st:1:1}" != " " ]; then
          # Staged AND further modified (git status `MM`). See the block
          # comment above this function: the patch below only captures
          # worktree-vs-HEAD, so repairing this would drop the staged blob
          # with no record of it anywhere. Always genuine.
          GENUINE+=("$p (staged and further modified — the staged version would not be captured by the repair, refusing)")
          continue
        fi ;;
    esac

    # A tracked file that still exists but differs from HEAD.
    if [ -z "$BRANCH_POINT" ]; then
      # No common ancestor with trunk could be established — cannot verify
      # either rule below. Refuse rather than guess.
      GENUINE+=("$p (modified, and no branch point could be found to check history against — refusing)")
      continue
    fi

    if path_touched_by_branch "$p"; then
      # The branch's own commits touched this path — a content match to old
      # history is far more likely to be a deliberate revert than a stray
      # `git checkout`. See rule 1 in the block comment above. Always genuine.
      GENUINE+=("$p (modified, and $BRANCH's own commits touched this path — a match to old history is not enough on its own, refusing)")
      continue
    fi

    # Repairable only if this exact content (and mode) already existed on
    # this path at or before the point the branch diverged from trunk — see
    # rule 2 above. This walks every revision of the path back to the branch
    # point for every dirty path (O(revisions) per path); fine at this
    # repo's size, but worth knowing before this comment is the only warning
    # you get on a much larger history.
    matched=""
    mode_only_rev=""
    wt_blob="$(git -C "$WT_DIR" hash-object -- "$p" 2>/dev/null || true)"
    while IFS= read -r rev; do
      if git -C "$WT_DIR" diff --quiet "$rev" -- "$p" </dev/null 2>/dev/null; then
        matched="$rev"
        break
      fi
      if [ -z "$mode_only_rev" ] && [ -n "$wt_blob" ]; then
        rev_blob="$(git -C "$WT_DIR" rev-parse -q --verify "$rev:$p" </dev/null 2>/dev/null || true)"
        if [ -n "$rev_blob" ] && [ "$rev_blob" = "$wt_blob" ]; then
          mode_only_rev="$rev"
        fi
      fi
    done < <(git -C "$WT_DIR" rev-list --full-history "$BRANCH_POINT" -- "$p" </dev/null 2>/dev/null || true)

    if [ -n "$matched" ]; then
      REPAIRABLE+=("$p")
      MATCHES+=("$p (reverted to $(git -C "$WT_DIR" rev-parse --short "$matched" </dev/null))")
    elif [ -n "$mode_only_rev" ]; then
      # Content is identical to a past revision; only the file mode differs.
      # Not the checkout signature (that restores mode too), so still
      # genuine — but say what actually happened instead of implying the
      # content itself is new.
      GENUINE+=("$p (mode changed; content is identical to $(git -C "$WT_DIR" rev-parse --short "$mode_only_rev" </dev/null), refusing)")
    else
      GENUINE+=("$p (modified, and this content is nowhere in $BRANCH history at or before its branch point)")
    fi
  done < <(git -C "$WT_DIR" status --porcelain -z 2>/dev/null || true)
}

if [ -d "$WT_DIR" ]; then
  triage_worktree

  if [ "${#GENUINE[@]}" -gt 0 ]; then
    echo "worktree $WT_DIR has uncommitted changes — commit or discard them first" >&2
    echo "refusing to merge or remove anything" >&2
    for line in "${GENUINE[@]}"; do echo "  genuine: $line" >&2; done
    if [ "${#MATCHES[@]}" -gt 0 ]; then
      for line in "${MATCHES[@]}"; do echo "  repairable, but left alone: $line" >&2; done
    fi
    exit 1
  fi

  if [ "${#REPAIRABLE[@]}" -gt 0 ]; then
    COMMON_GIT_DIR="$(git rev-parse --git-common-dir)"
    case "$COMMON_GIT_DIR" in /*) ;; *) COMMON_GIT_DIR="$ROOT/$COMMON_GIT_DIR" ;; esac
    REPAIR_DIR="$COMMON_GIT_DIR/finish-worktree-repairs"
    mkdir -p "$REPAIR_DIR"
    PATCH="$REPAIR_DIR/$ID-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$WT_DIR" diff HEAD --binary -- "${REPAIRABLE[@]}" > "$PATCH"

    echo "!! $WT_DIR was modified after its last commit, and every change is a" >&2
    echo "!! revert to an older revision of the same file already in $BRANCH." >&2
    echo "!! that is the signature of a read-only agent editing through git (OT-122)." >&2
    echo "!! restoring from $BRANCH HEAD before merging:" >&2
    for line in "${MATCHES[@]}"; do echo "!!   $line" >&2; done
    echo "!! pre-repair state saved as a patch: $PATCH" >&2

    git -C "$WT_DIR" checkout HEAD -- "${REPAIRABLE[@]}"

    if [ -n "$(git -C "$WT_DIR" status --porcelain 2>/dev/null)" ]; then
      echo "restore left $WT_DIR still dirty — refusing to merge or remove anything" >&2
      git -C "$WT_DIR" status --short >&2
      exit 1
    fi
    echo "!! worktree restored and clean; continuing with the merge" >&2
  fi
fi

if ! git merge --no-ff --no-edit "$BRANCH" 2>/tmp/finish-worktree-merge-err.$$; then
  cat /tmp/finish-worktree-merge-err.$$ >&2
  rm -f /tmp/finish-worktree-merge-err.$$
  git merge --abort 2>/dev/null || true
  echo "merge failed — worktree and branch left in place for manual resolution" >&2
  exit 1
fi
rm -f /tmp/finish-worktree-merge-err.$$

echo "merged $BRANCH into $CUR_BRANCH" >&2

if [ -d "$WT_DIR" ]; then
  git worktree remove "$WT_DIR" --force 2>&1 >&2
  echo "worktree removed: $WT_DIR" >&2
fi

git branch -d "$BRANCH" 2>&1 >&2
echo "branch deleted: $BRANCH" >&2
echo "done"
