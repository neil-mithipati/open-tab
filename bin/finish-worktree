#!/usr/bin/env bash
# bin/finish-worktree — merges a task's branch into main and removes the
# worktree. Must be run from the main checkout, never from inside a worktree.
#
#   ./bin/finish-worktree TB-004
#
# Refuses rather than forcing through anything unsafe: uncommitted changes in
# the worktree, or a merge that doesn't fast-forward or apply clean. On refusal
# the worktree is left exactly as it was — nothing is deleted until the merge
# has actually succeeded.
#
# The one exception is narrow and loud: if every uncommitted change is a revert
# to a revision of that same file already in the branch's history — the mark of
# a read-only reviewer that ran `git checkout <rev> -- <path>` and never put it
# back — the file is restored from HEAD and the merge continues, with the
# pre-repair state saved as a patch. See the triage block below.

set -euo pipefail

ID="${1:-}"
[ -z "$ID" ] && { echo "usage: ./bin/finish-worktree <task-id>" >&2; exit 1; }

case "$ID" in
  *[!A-Za-z0-9_-]*) echo "task id must be alphanumeric, - or _ only: $ID" >&2; exit 1 ;;
esac

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repo" >&2; exit 1; }
cd "$ROOT"

CUR_BRANCH="$(git symbolic-ref --short -q HEAD || true)"
if [ -z "$CUR_BRANCH" ]; then
  echo "HEAD is detached — run this from the trunk checkout, not inside a worktree" >&2
  exit 1
fi
# Refuse to run from inside a task worktree, whatever the trunk happens to be
# named — checked by looking for a task/ branch prefix pattern rather than
# assuming the trunk is literally called "main" or "master".
case "$CUR_BRANCH" in
  task/*) echo "run this from the trunk checkout, not from inside a worktree (currently on: $CUR_BRANCH)" >&2; exit 1 ;;
esac

BRANCH="task/$ID"
WT_DIR="../wt-$ID"

if ! git rev-parse --verify -q "$BRANCH" >/dev/null; then
  echo "no branch $BRANCH — nothing to finish" >&2
  exit 1
fi

# --- uncommitted-change triage (OT-122) --------------------------------------
#
# A read-only reviewer left a STAGED revert sitting in a worktree: it ran
# `git checkout <old-rev> -- <path>` to compare before/after while reviewing,
# then never restored the file. The `disallowedTools: Write, Edit` contract on
# reviewer agents is enforced on those two tools only, and git is a perfectly
# capable file editor reachable from Bash.
#
# Of the three options in ledger/OT-122.md this is option 3, detect-and-repair.
# Why not the other two:
#   1. A PreToolUse Bash guard for read-only agents has to be registered in
#      .claude/settings.json, which was under concurrent edit by OT-121; and a
#      string-match guard over arbitrary shell is exactly the kind of thing
#      that starts denying legitimate reviews, which costs more than the bug.
#   2. Handing reviewers a read-only view changes how every reviewer prompt
#      addresses paths — the largest blast radius for the smallest repo.
#   3. This sits on the path that already caught the incident, costs one
#      function, and cannot make a review harder because it does not run
#      during one.
#
# The rule that keeps this from swallowing real work: a dirty path is
# repairable only if its current working-tree content is byte-identical to some
# revision of that same path already reachable from HEAD. That is precisely the
# `git checkout <rev> -- <path>` signature, and it is the only case where
# discarding the change provably loses nothing, because the content is still in
# history. Anything else — an untracked file, a new file, a deletion, a rename,
# or any content that has never existed on this branch — is genuine unmerged
# work and still refuses, exactly as before. If even one path is genuine,
# nothing is repaired and the whole thing refuses. And the pre-repair state is
# written out as a patch first, so the repair itself is reversible too.

GENUINE=()
REPAIRABLE=()
MATCHES=()

triage_worktree() {
  local entry st p orig rev matched

  while IFS= read -r -d '' entry; do
    st="${entry:0:2}"
    p="${entry:3}"

    case "$st" in
      '??')
        GENUINE+=("$p (untracked)")
        continue ;;
      R?|?R|C?|?C)
        # rename/copy emits a second NUL field holding the original path
        IFS= read -r -d '' orig || orig="?"
        GENUINE+=("$p (renamed/copied from $orig, not committed)")
        continue ;;
      A?|?A)
        GENUINE+=("$p (added, not committed)")
        continue ;;
      U?|?U)
        GENUINE+=("$p (unmerged)")
        continue ;;
      *D*)
        GENUINE+=("$p (deleted, not committed)")
        continue ;;
    esac

    # A tracked file that still exists but differs from HEAD. Repairable only
    # if this exact content is already somewhere in the path's own history.
    matched=""
    while IFS= read -r rev; do
      if git -C "$WT_DIR" diff --quiet "$rev" -- "$p" </dev/null 2>/dev/null; then
        matched="$rev"
        break
      fi
    done < <(git -C "$WT_DIR" rev-list --full-history HEAD -- "$p" </dev/null 2>/dev/null || true)

    if [ -n "$matched" ]; then
      REPAIRABLE+=("$p")
      MATCHES+=("$p (reverted to $(git -C "$WT_DIR" rev-parse --short "$matched" </dev/null))")
    else
      GENUINE+=("$p (modified, and this content is nowhere in $BRANCH history)")
    fi
  done < <(git -C "$WT_DIR" status --porcelain -z 2>/dev/null || true)
}

if [ -d "$WT_DIR" ]; then
  triage_worktree

  if [ "${#GENUINE[@]}" -gt 0 ]; then
    echo "worktree $WT_DIR has uncommitted changes — commit or discard them first" >&2
    echo "refusing to merge or remove anything" >&2
    for line in "${GENUINE[@]}"; do echo "  genuine: $line" >&2; done
    if [ "${#MATCHES[@]}" -gt 0 ]; then
      for line in "${MATCHES[@]}"; do echo "  repairable, but left alone: $line" >&2; done
    fi
    exit 1
  fi

  if [ "${#REPAIRABLE[@]}" -gt 0 ]; then
    COMMON_GIT_DIR="$(git rev-parse --git-common-dir)"
    case "$COMMON_GIT_DIR" in /*) ;; *) COMMON_GIT_DIR="$ROOT/$COMMON_GIT_DIR" ;; esac
    REPAIR_DIR="$COMMON_GIT_DIR/finish-worktree-repairs"
    mkdir -p "$REPAIR_DIR"
    PATCH="$REPAIR_DIR/$ID-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$WT_DIR" diff HEAD --binary -- "${REPAIRABLE[@]}" > "$PATCH"

    echo "!! $WT_DIR was modified after its last commit, and every change is a" >&2
    echo "!! revert to an older revision of the same file already in $BRANCH." >&2
    echo "!! that is the signature of a read-only agent editing through git (OT-122)." >&2
    echo "!! restoring from $BRANCH HEAD before merging:" >&2
    for line in "${MATCHES[@]}"; do echo "!!   $line" >&2; done
    echo "!! pre-repair state saved as a patch: $PATCH" >&2

    git -C "$WT_DIR" checkout HEAD -- "${REPAIRABLE[@]}"

    if [ -n "$(git -C "$WT_DIR" status --porcelain 2>/dev/null)" ]; then
      echo "restore left $WT_DIR still dirty — refusing to merge or remove anything" >&2
      git -C "$WT_DIR" status --short >&2
      exit 1
    fi
    echo "!! worktree restored and clean; continuing with the merge" >&2
  fi
fi

if ! git merge --no-ff --no-edit "$BRANCH" 2>/tmp/finish-worktree-merge-err.$$; then
  cat /tmp/finish-worktree-merge-err.$$ >&2
  rm -f /tmp/finish-worktree-merge-err.$$
  git merge --abort 2>/dev/null || true
  echo "merge failed — worktree and branch left in place for manual resolution" >&2
  exit 1
fi
rm -f /tmp/finish-worktree-merge-err.$$

echo "merged $BRANCH into $CUR_BRANCH" >&2

if [ -d "$WT_DIR" ]; then
  git worktree remove "$WT_DIR" --force 2>&1 >&2
  echo "worktree removed: $WT_DIR" >&2
fi

git branch -d "$BRANCH" 2>&1 >&2
echo "branch deleted: $BRANCH" >&2
echo "done"
