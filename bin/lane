#!/bin/bash
# Launch the orchestrator.
#
#   ./bin/lane              uses this app's lane automatically
#   ./bin/lane open-tab     explicit, only if you're tracking sub-workstreams
#
# One fleet per app means one lane per app in the common case, so you shouldn't
# have to remember or type a name. This reads .claude/budget.json: if exactly
# one lane is configured, it's used automatically. An explicit argument is
# validated against that file rather than accepted as-is — a typo used to
# silently create a new lane with garbage spend data instead of failing.
#
# The lane still exists under the hood regardless: OTEL_* variables are not
# inherited by subprocesses Claude Code spawns, so telemetry config has to be
# set at launch rather than discovered, and it flows two ways — as an OTel
# resource attribute for spend attribution, and as $LANE for the hooks, which
# do inherit the ordinary environment.

set -euo pipefail

if [ ! -f .claude/budget.json ]; then
  echo "No .claude/budget.json — the spend cap will refuse to run uncapped." >&2
  exit 1
fi

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

configured=$(jq -r '.lanes | keys | join(" ")' .claude/budget.json 2>/dev/null)
if [ -z "$configured" ]; then
  echo "No lanes in .claude/budget.json. Add one, e.g.:" >&2
  echo '  jq ".lanes[\"my-app\"] = 8.00" .claude/budget.json > t && mv t .claude/budget.json' >&2
  exit 1
fi

LANE_NAME="${1:-}"

if [ -z "$LANE_NAME" ]; then
  count=$(echo "$configured" | wc -w | tr -d ' ')
  if [ "$count" -eq 1 ]; then
    LANE_NAME="$configured"
    echo "lane: $LANE_NAME"
  else
    echo "Multiple lanes configured — say which one:" >&2
    for l in $configured; do echo "  ./bin/lane $l" >&2; done
    exit 1
  fi
else
  match=no
  for l in $configured; do [ "$l" = "$LANE_NAME" ] && match=yes; done
  if [ "$match" = "no" ]; then
    echo "'$LANE_NAME' is not in .claude/budget.json. Configured lanes:" >&2
    for l in $configured; do echo "  $l" >&2; done
    exit 1
  fi
fi

export LANE="$LANE_NAME"
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=prometheus
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_RESOURCE_ATTRIBUTES="lane=${LANE_NAME}"

if ! pgrep -f "spend-poll.sh" >/dev/null 2>&1; then
  echo "starting spend-poll.sh..."
  nohup ./.claude/hooks/spend-poll.sh >/dev/null 2>&1 &
  disown
  # Give it a moment to bind before checking, rather than checking instantly and
  # reporting a false failure.
  sleep 2
fi

if curl -sf localhost:9464/metrics >/dev/null 2>&1; then
  echo "spend tracking is live"
else
  echo "warning: localhost:9464/metrics is not responding — the spend cap will run uncapped" >&2
fi

# This variable outranks every model: field in .claude/agents/. If it is set, the
# builder tiers collapse to one model and the cost design silently stops working.
if [ -n "${CLAUDE_CODE_SUBAGENT_MODEL:-}" ]; then
  echo "warning: CLAUDE_CODE_SUBAGENT_MODEL=$CLAUDE_CODE_SUBAGENT_MODEL overrides all per-agent tiers" >&2
fi

exec claude --agent orchestrator
